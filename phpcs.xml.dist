<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="field_guard">
  <description>PHP CodeSniffer ruleset for the Field Guard module.</description>

  <file>.</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
