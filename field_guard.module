<?php

/**
 * @file
 * Config-driven per-field access control that fails closed.
 *
 * See README.md for the threat model. The short version:
 * hook_entity_field_access returning AccessResult::forbidden() is the only
 * verdict in Drupal's stack with no permission-based override, and this module
 * is a thin, auditable wrapper around that fact.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_entity_field_access().
 *
 * Why forbidden() and not neutral():
 *
 * EntityAccessControlHandler::fieldAccess() folds every hook result together
 * with orIf() (EntityAccessControlHandler.php:369) and AccessResult::orIf()
 * short-circuits to forbidden when either side is forbidden
 * (AccessResult.php:308-309). AccessResultForbidden declares no orIf()
 * override, so that contagion is total. fieldAccess() itself contains no
 * admin-permission check at all — unlike checkAccess(), there is no field-level
 * equivalent of the entity-level admin bypass, and the entity-level one is
 * skipped outright once a hook has forbidden
 * (EntityAccessControlHandler.php:108).
 *
 * The practical consequence, which is the entire point of this module: the
 * denial holds against 'administer users'/'administer profile', against a role
 * with is_admin: TRUE, and against uid 1. Those are all permission-level
 * mechanisms (SuperUserAccessPolicy.php:20-24 ->
 * CalculatedPermissionsItem::hasPermission()) and none of them participates in
 * AccessResult folding.
 *
 * That is deliberate. A record the subject or an administrator can silently
 * rewrite is not evidence of anything — and under an immutable-backup regime a
 * falsified value cannot be recalled. The legitimate way to write one is to
 * hold the permission the site's map names for the field, which is a grant
 * that appears in a config diff.
 */
function field_guard_entity_field_access(
  string $operation,
  FieldDefinitionInterface $field_definition,
  AccountInterface $account,
  ?FieldItemListInterface $items = NULL,
): AccessResultInterface {
  /** @var \Drupal\field_guard\ProtectedFieldMap $map */
  $map = \Drupal::service('field_guard.field_map');

  $permission = $map->requiredPermission(
    $field_definition->getTargetEntityTypeId(),
    $field_definition->getTargetBundle(),
    $field_definition->getName(),
    $operation,
  );

  // Not a field we were told to protect. Stay silent: neutral folds away under
  // orIf and cannot widen access another module intended to restrict. This
  // module only ever denies — it never grants.
  if ($permission === NULL) {
    return AccessResult::neutral();
  }

  // Fail closed on a definition-level check.
  //
  // JSON:API's FieldResolver::getFieldAccess() and Views' EntityField::access()
  // both call this hook with $items = NULL, to decide whether a field may be
  // FILTERED or SORTED on rather than whether a particular value may be read.
  // drupal/field_permissions returns neutral in exactly this case
  // (field_permissions.module:35-38), which is why a value-aware deny fails
  // open on those paths — a defect acknowledged upstream as issue #3003914 and
  // unfixed since 2021.
  //
  // We deny instead. If the caller will not say which entity it means, it does
  // not get the field. This also removes the Views handler at definition time,
  // which is what stops an exposed date filter from being used to binary-search
  // a protected value that is never rendered.
  //
  // Note this makes protected fields non-filterable and non-sortable for
  // everyone, including holders of the permission. That is the intended trade:
  // there is no way to distinguish a legitimate filter from a probe at this
  // layer.
  if ($items === NULL) {
    // Cacheability: this verdict is the SAME for every account — it does not
    // consult $account at all — so it carries no user cache context. It
    // previously carried 'user.permissions', which fragmented the cache per
    // permission set for an identical answer. It does depend on the guarded-
    // field map, so it takes the map's cache tags (config:field_guard.settings)
    // and nothing else.
    //
    // This is the one path where the metadata is actually consumed: JSON:API's
    // FieldResolver::getFieldAccess() calls fieldAccess() with
    // $return_as_object = TRUE
    // (core/modules/jsonapi/src/Context/FieldResolver.php:763) and folds the
    // result into the cacheable response. The render path calls it with FALSE
    // and discards the metadata entirely, so correctness there rests on the
    // render array, not on us.
    return AccessResult::forbidden(
      'Guarded fields cannot be filtered or sorted on; access requires an entity context.'
    )->addCacheableDependency($map);
  }

  // Own-subject view exemption: opt-in per field, view only. When the map
  // flags the field and the entity it sits on ultimately hangs from the
  // acting user's OWN account, this module stands aside with neutral — it
  // never grants, so ordinary entity and field access still decide. The
  // subject reading a record about themselves is not the threat this module
  // exists to remove; the subject REWRITING it is, which is why there is no
  // edit counterpart and why the definition-level deny above still applies
  // (an own-subject filter probe is indistinguishable from any other probe).
  if ($operation === 'view'
    && $map->viewExemptsOwnSubject(
      $field_definition->getTargetEntityTypeId(),
      $field_definition->getTargetBundle(),
      $field_definition->getName(),
    )
  ) {
    /** @var \Drupal\field_guard\HostChainWalker $walker */
    $walker = \Drupal::service('field_guard.host_chain_walker');
    $chain = $walker->chain($items->getEntity());

    if (_field_guard_chain_is_own_subject($chain, $account)) {
      // Depends on identity (which uid is asking) and on the chain, nothing
      // else — the subject needs no permission.
      $verdict = AccessResult::neutral()->addCacheContexts(['user']);
    }
    else {
      // A non-subject on a flagged field is exactly the ordinary
      // permission-based verdict, plus the ownership question. It therefore
      // needs BOTH the identity context ('user' — two accounts with identical
      // roles get different answers when one is the subject) AND the
      // role/permission contexts: 'user' alone keys the cache per uid but
      // carries nothing that changes when a role's permission list changes,
      // so a cached verdict would outlive a grant or a revocation.
      $verdict = AccessResult::forbiddenIf(
        !_field_guard_has_explicit_permission($account, $permission),
        sprintf("The '%s' permission must be explicitly granted for this field.", $permission),
      )->addCacheContexts(['user', 'user.roles', 'user.permissions']);
    }

    // Both arms depend on the map and on the host chain: re-parenting any
    // link flips ownership, and each chain entity's tags invalidate the
    // cached verdict when that happens. A NULL chain (cycle, depth cap)
    // fails closed above — cover at least the host entity itself.
    $verdict->addCacheableDependency($map);
    foreach ($chain ?? [$items->getEntity()] as $link) {
      $verdict->addCacheableDependency($link);
    }
    return $verdict;
  }

  // The value-level verdict DOES depend on the account (which roles the
  // account holds and those roles' permission lists), so the user contexts
  // stay. The map dependency is added because whether this field is guarded
  // at all comes from config — without it a settings change leaves the
  // previous verdict cached.
  return AccessResult::forbiddenIf(
    !_field_guard_has_explicit_permission($account, $permission),
    sprintf("The '%s' permission must be explicitly granted for this field.", $permission),
  )->addCacheContexts(['user.roles', 'user.permissions'])->addCacheableDependency($map);
}

/**
 * Decides whether a resolved host chain roots at the acting user's account.
 *
 * The root must be a User entity that IS the acting account. Anonymous never
 * owns a record. A NULL chain means the walk could not establish a root
 * (cycle, depth cap, or a broken parent accessor) — that is a refusal, not an
 * unknown: an exemption must rest on a proven subject.
 *
 * @param \Drupal\Core\Entity\EntityInterface[]|null $chain
 *   The host chain from HostChainWalker::chain(), root last, or NULL.
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The acting account.
 *
 * @return bool
 *   TRUE when the chain's root is the acting user's own account.
 */
function _field_guard_chain_is_own_subject(?array $chain, AccountInterface $account): bool {
  if ($chain === NULL || !$account->isAuthenticated()) {
    return FALSE;
  }

  $root = end($chain);

  return $root instanceof UserInterface
    && (int) $root->id() === (int) $account->id();
}

/**
 * Checks whether a permission is EXPLICITLY granted by a non-admin role.
 *
 * This deliberately does not use AccountInterface::hasPermission(). That method
 * returns TRUE for every permission when the account holds a role with
 * is_admin: TRUE, or when it is uid 1 (SuperUserAccessPolicy.php:20-24 adds a
 * CalculatedPermissionsItem whose isAdmin flag short-circuits
 * CalculatedPermissionsItem::hasPermission() at :64-66). Gating on it would
 * mean administrators and uid 1 silently pass every check — which is exactly
 * the property this module exists to remove.
 *
 * The forbidden verdict returned by the caller genuinely cannot be overridden
 * by any permission, role or uid. But that only matters once we have DECIDED to
 * forbid; the decision itself must not be delegated to a permission calculation
 * that hands admins everything. This function is that distinction, and it is
 * the subtle part of the module.
 *
 * The practical effect: to read or write a protected field you must hold a role
 * that names the permission in its own configuration. Granting it is therefore
 * a visible line in a `config/sync` diff, reviewed like any other change —
 * rather than something inherited by virtue of being an administrator.
 * Separation of duty is the goal: an attestation the site administrator can
 * rewrite without leaving a trace is not evidence.
 *
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The account to test.
 * @param string $permission
 *   The permission that must be explicitly granted.
 *
 * @return bool
 *   TRUE when a non-admin role held by the account grants the permission.
 */
function _field_guard_has_explicit_permission(AccountInterface $account, string $permission): bool {
  // One loadMultiple rather than a load() per role. Field access runs once per
  // field per entity, so a listing of N entities with M guarded fields reaches
  // this function N*M times; the per-role loop turned each of those into a
  // storage call per role. Entity storage does keep a static cache, so the
  // saving is smaller than it looks — but the single call is both cheaper on
  // the first pass and clearer.
  $roles = \Drupal::entityTypeManager()
    ->getStorage('user_role')
    ->loadMultiple($account->getRoles());

  foreach ($roles as $role) {
    /** @var \Drupal\user\RoleInterface $role */
    // Skip is_admin roles: their permission list is "everything", so consulting
    // it would reintroduce the bypass this function exists to close.
    if ($role->isAdmin()) {
      continue;
    }

    if ($role->hasPermission($permission)) {
      return TRUE;
    }
  }

  return FALSE;
}
